# Copy to .env and fill in. Never commit .env (it is git-ignored).
# scripts/reproduce_fdb_v3.sh copies it to FDB-v3's v3/.env.local, where the
# benchmark's own scripts read it.

# LiveKit Cloud project (free tier works): https://cloud.livekit.io -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI: the agent (Whisper STT, gpt-4o, tts-1 / gpt-realtime-1.5, gpt-4o vision
# for Show & Fix) and FDB-v3's gpt-4o judge (--use-llm).
OPENAI_API_KEY=

# Gemini API (free tier works): --pipeline gemini_realtime (Gemini Live), and
# Show & Fix's display reader under that pipeline (gemini-2.5-flash).
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq (free tier, open-weight models): only if [livekit.open] names provider
# "groq" for a stage (config/fdb_v3.toml). The default open pipeline is fully
# local and needs no key at all. https://console.groq.com/keys
GROQ_API_KEY=
